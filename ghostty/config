# Managed by dotfigs: ~/.config/ghostty/config -> ghostty/config.
# Army green, matching the Starship palette in shell/starship.toml.
# Reload while running: cmd+shift+, ; list options: ghostty +show-config --default --docs

# --- Look -------------------------------------------------------------------
font-family = Iosevka
font-size = 15

background = #1f2715
foreground = #00ff41
cursor-color = #00ff41
cursor-style = block
cursor-style-blink = true
# Shell integration normally swaps the cursor to a thin bar at the prompt;
# no-cursor keeps the chunky blinking block everywhere.
shell-integration-features = no-cursor
selection-background = #4b5a2e
selection-foreground = #00ff41

# ANSI 0-7 normal, 8-15 bright. Red/yellow/blue kept distinct so errors and
# diffs stay readable; everything else leans green.
palette = 0=#141a0d
palette = 1=#ff6e5e
palette = 2=#008f11
palette = 3=#c4e000
palette = 4=#00a86b
palette = 5=#3fbf7f
palette = 6=#00c932
palette = 7=#9fdfa8
palette = 8=#9aa877
palette = 9=#ff6b6b
palette = 10=#00ff41
palette = 11=#e5ff4d
palette = 12=#33d68a
palette = 13=#6fffb0
palette = 14=#5cff8f
palette = 15=#d6ffe0

background-opacity = 0.95
background-blur = 20
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
macos-titlebar-style = tabs

# Phosphor bloom + faint scanlines; tune the constants at the top of the file.
# Comment this out to turn it off.
custom-shader = shaders/crt.glsl

# --- Keys -------------------------------------------------------------------
# Vim-style tab movement: j = next (down), k = previous (up).
# Note: cmd+k replaces Ghostty's default "clear screen" (use ctrl+l instead).
keybind = cmd+j=next_tab
keybind = cmd+k=previous_tab

# Dropdown terminal from any app. Needs Accessibility permission
# (System Settings > Privacy & Security) and Ghostty running (Open at Login).
keybind = global:cmd+grave_accent=toggle_quick_terminal

# Vim-style split focus. performable: only takes the key when a split exists in
# that direction; otherwise ctrl+h/j/k/l reach the shell/editor as usual (so
# ctrl+l still clears the screen unless there's a split to the right).
keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+j=goto_split:down
keybind = performable:ctrl+k=goto_split:up
keybind = performable:ctrl+l=goto_split:right
